include <args.bare>
include <forms.bare>

include 'ollamaChatUtil.bare'
include 'ollamaChatVoice.bare'


# The Ollama Chat conversation page
async function ollamaChatConversationPage(args):
    id = objectGet(args, 'id')

    # Fetch the conversation
    if id != null:
        conversationResponse = systemFetch('getConversation?id=' + id)
        conversationResponse = if(conversationResponse != null, jsonParse(conversationResponse))
        if conversationResponse == null:
            ollamaChatErrorPage('Unknown conversation ID')
            return
        endif
        conversation = objectGet(conversationResponse, 'conversation')
        title = objectGet(conversation, 'title')
        model = objectGet(conversation, 'model')
        generating = objectGet(conversation, 'generating')
    else:
        conversation = null
        title = ollamaChatTitle
        model = null
        generating = false
    endif

    # Sync the voice playback, if any, and re-render the page when its state changes on its own
    ollamaChatConversationVoiceSync(args, conversation, generating)
    voiceSetChange(systemPartial(ollamaChatConversationOnClick, args, null, null, false))

    # Render the floating controls
    elementModelRender(ollamaChatConversationFloatingElements(args, conversation, generating))
    documentSetFocus(ollamaChatConversationPromptID)

    # Render the chat title
    documentSetTitle(title)
    if conversation != null && objectGet(args, 'action') == 'title':
        markdownPrint('', '**Title:**')
        titleClickFn = systemPartial(ollamaChatConversationOnTitleUpdate, args)
        cancelClickFn = systemPartial(ollamaChatConversationOnClick, args, null, argsURL(ollamaChatArguments), false)
        elementModelRender([ \
            {'html': 'p', 'elem': formsTextElements(ollamaChatConversationTitleID, title, 50, titleClickFn)}, \
            {'html': 'p', 'elem': [ \
                formsLinkButtonElements('Update', titleClickFn), \
                {'text': '\u00a0\u00a0'}, \
                formsLinkButtonElements('Cancel', cancelClickFn) \
            ]} \
        ])
        documentSetFocus(ollamaChatConversationTitleID)
    elif conversation != null:
        markdownPrint('# ' + markdownEscape(title), '', '**Model:** ' + markdownEscape(model))
    endif

    # No conversation yet or empty conversation?
    exchanges = if(conversation, objectGet(conversation, 'exchanges'))
    if !conversation || !exchanges:
        return
    endif

    # Render the exchanges
    ixExchangeLast = arrayLength(exchanges) - 1
    for exchange, ixExchange in exchanges:
        # Render the message: anchor, User heading, previous/next navigation, user message, Model heading
        messageElementID = stringSlice(argsURL(ollamaChatArguments, null, false, ollamaChatConversationMessageID + '-' + ixExchange), 1)
        elementModelRender([ \
            {'html': 'div', 'attr': {'id': messageElementID}}, \
            {'html': 'h2', 'elem': {'text': 'User:'}}, \
            ollamaChatConversationMessageNavElements(ixExchange, ixExchangeLast, generating), \
            { \
                'html': 'p', \
                'attr': {'style': 'white-space: pre-wrap;'}, \
                'elem': {'text': objectGet(exchange, 'user')} \
            }, \
            {'html': 'h2', 'elem': {'text': 'Model:'}} \
        ])
        ollamaChatConversationResponseRenderTop(args, exchange, ixExchange, !generating || ixExchange != ixExchangeLast)
        if ixExchange != ixExchangeLast:
            ollamaChatConversationResponseRenderBottom(args, exchange, ixExchange)
        endif
    endfor

    # Render the document reset ID
    elementModelRender({'html': 'div', 'attr': {'id': ollamaChatConversationResetID}})

    # Render the bottom of the conversation page
    ollamaChatConversationPageBottom(args, conversation, generating)
endfunction


# Helper to render the bottom of Ollama Chat conversation page
function ollamaChatConversationPageBottom(args, conversation, generating):
    multiline = objectGet(args, 'multiline')

    # Any exchanges?
    isThinking = false
    exchanges = objectGet(conversation, 'exchanges')
    if arrayLength(exchanges):
        # Thinking?
        ixLastExchange = arrayLength(exchanges) - 1
        lastExchange = arrayGet(exchanges, ixLastExchange)
        isThinking = objectHas(lastExchange, 'thinking')

        # Render the model reply
        ollamaChatConversationResponseRenderBottom(args, lastExchange, ixLastExchange)

        # Compute button on-click functions
        deleteExchangeFn = systemPartial(ollamaChatConversationOnClick, args, 'deleteConversationExchange', null, false)
        regenerateExchangeFn = systemPartial(ollamaChatConversationOnClick, args, 'regenerateConversationExchange', null, false)

        # Render the bottom menu: a Previous link to the top of the last message plus the delete and regenerate links
        if !generating:
            elementModelRender( \
                {'html': 'p', 'elem': [ \
                    formsLinkElements('Previous', \
                        argsURL(ollamaChatArguments, null, false, ollamaChatConversationMessageID + '-' + ixLastExchange)), \
                    {'text': '\u00a0|\u00a0'}, \
                    formsLinkButtonElements('Delete', deleteExchangeFn), \
                    {'text': '\u00a0|\u00a0'}, \
                    formsLinkButtonElements('Regenerate', regenerateExchangeFn) \
                ]} \
            )
        endif
    endif

    # Render the bottom space (more when the voice playback bar is shown)
    fontSizePx = documentFontSize()
    bottomSpaceEm = if(generating, mathFloor(0.67 * windowHeight() / fontSizePx), if(multiline, 12, 4))
    bottomSpacePx = (bottomSpaceEm + if(voiceState() != null, ollamaChatConversationVoiceSpaceEm, 0)) * fontSizePx
    bottomElementId = stringSlice(argsURL(ollamaChatArguments, null, false, ollamaChatConversationBottomID), 1)
    elementModelRender([ \
        {'html': 'div', 'attr': {'style': 'height: ' + numberToFixed(bottomSpacePx, ollamaChatConversationSVGPrecision) + 'px'}}, \
        {'html': 'div', 'attr': {'id': bottomElementId}} \
    ])

    # Set the conversation update timeout
    if generating:
        windowSetTimeout( \
            systemPartial(ollamaChatConversationOnTimeout, args, arrayLength(exchanges), isThinking), \
            ollamaChatConversationTimeoutMs \
        )
    endif
endfunction


# Helper to render the model response top part - the Read Aloud link (final is true if the response is complete),
# then the show/hide thinking link, if any
function ollamaChatConversationResponseRenderTop(args, exchange, ixExchange, final):
    readAloudFn = systemPartial(ollamaChatConversationOnReadAloud, args, ixExchange, objectGet(exchange, 'model'), final)
    links = [formsLinkButtonElements('Read Aloud', readAloudFn)]

    # Show/hide thinking link? (not in text view)
    if !objectGet(args, 'text') && objectHas(exchange, 'thinking'):
        arrayPush(links, {'text': '\u00a0|\u00a0'})
        if ixExchange == objectGet(args, 'think'):
            arrayPush(links, formsLinkElements('Hide Thinking', argsURL(ollamaChatArguments, {'think': null})))
        else:
            arrayPush(links, formsLinkElements('Show Thinking', argsURL(ollamaChatArguments, {'think': ixExchange})))
        endif
    endif

    elementModelRender({'html': 'p', 'elem': links})
endfunction


# Helper to render the model response bottom part
function ollamaChatConversationResponseRenderBottom(args, exchange, ixExchange):
    # Text view?
    if objectGet(args, 'text'):
        elementModelRender({'html': 'pre', 'elem': {'text': objectGet(exchange, 'model')}})
        return
    endif

    # Thinking response?
    thinking = objectGet(exchange, 'thinking')
    if thinking && ixExchange == objectGet(args, 'think'):
        # Render the "</think>" marker as an element model so an unterminated code block in the
        # thinking markdown doesn't swallow it (and the separator below) into the code block
        markdownPrint('', '**<think>**', '', thinking)
        elementModelRender({'html': 'p', 'elem': {'html': 'strong', 'elem': {'text': '</think>'}}})
        markdownPrint('', '-----')
    endif

    # Render the response
    markdownPrint('', objectGet(exchange, 'model'))
endfunction


# Helper that returns a message's previous/next navigation paragraph (rendered below its User heading)
function ollamaChatConversationMessageNavElements(ixExchange, ixExchangeLast, generating):
    # Link to the previous message (except the first)
    links = []
    if ixExchange != 0:
        arrayPush(links, formsLinkElements('Previous', \
            argsURL(ollamaChatArguments, null, false, ollamaChatConversationMessageID + '-' + (ixExchange - 1))))
    endif

    # Link to the next message, or to the conversation bottom for the last message. While generating, the
    # last message's bottom menu (with its "Previous" counterpart) is hidden, so omit its "Next" link.
    isLast = ixExchange == ixExchangeLast
    if !isLast || !generating:
        if arrayLength(links):
            arrayPush(links, {'text': '\u00a0|\u00a0'})
        endif
        nextAnchor = if(!isLast, ollamaChatConversationMessageID + '-' + (ixExchange + 1), ollamaChatConversationBottomID)
        arrayPush(links, formsLinkElements('Next', argsURL(ollamaChatArguments, null, false, nextAnchor)))
    endif

    # No links (the first exchange while generating)? Render nothing
    return if(arrayLength(links), {'html': 'p', 'elem': links})
endfunction


# Conversation update timeout handler
async function ollamaChatConversationOnTimeout(args, originalExchangeCount, originalThinking):
    id = objectGet(args, 'id')

    # Fetch the conversation
    conversationResponse = systemFetch('getConversation?id=' + id)
    conversationResponse = if(conversationResponse != null, jsonParse(conversationResponse))
    if conversationResponse == null:
        ollamaChatErrorPage('Unknown conversation ID')
        return
    endif
    conversation = objectGet(conversationResponse, 'conversation')
    generating = objectGet(conversation, 'generating')

    # Done generating? Re-render the page to update the floating controls
    if !generating:
        ollamaChatConversationSavePrompt()
        ollamaChatConversationPage(args)
        return
    endif

    # Has anything changed that requires a re-render?
    exchanges = objectGet(conversation, 'exchanges')
    exchangeCount = arrayLength(exchanges)
    lastExchange = arrayGet(exchanges, exchangeCount - 1)
    isThinking = objectHas(lastExchange, 'thinking')
    if exchangeCount != originalExchangeCount || isThinking != originalThinking:
        ollamaChatConversationPage(args)
        return
    endif

    # Sync the voice playback, if any, and render the page bottom
    ollamaChatConversationVoiceSync(args, conversation, generating)
    documentSetReset(ollamaChatConversationResetID)
    ollamaChatConversationPageBottom(args, conversation, generating)
endfunction


# The conversation refresh period, in milliseconds
ollamaChatConversationTimeoutMs = 500


# The conversation prompt input ID
ollamaChatConversationPromptID = 'ollama-chat-prompt'


# The conversation title input ID
ollamaChatConversationTitleID = 'ollama-chat-title'


# The conversation prompt session storage key
ollamaChatConversationSessionKey = 'ollama-chat-conversation-message'


# The conversation document reset ID
ollamaChatConversationResetID = 'ollama-chat-document-reset-id'


# The conversation bottom element ID (for scroll to bottom)
ollamaChatConversationBottomID = 'chat-bottom'


# The conversation message element ID prefix (for previous/next navigation)
ollamaChatConversationMessageID = 'chat-message'


# The voice playback bar's additional bottom space, in em
ollamaChatConversationVoiceSpaceEm = 4


# The SVG numeric attribute precision
ollamaChatConversationSVGPrecision = 3


# Helper to save the prompt to session storage prior to a full re-render
function ollamaChatConversationSavePrompt():
    prompt = stringTrim(documentInputValue(ollamaChatConversationPromptID))
    if prompt != '':
        sessionStorageSet(ollamaChatConversationSessionKey, prompt)
    endif
endfunction


# Generic conversation button on-click event handler
async function ollamaChatConversationOnClick(args, api, url, noSave):
    # Call the api, if any
    if api != null:
        systemFetch({'url': api, 'body': jsonStringify({'id': objectGet(args, 'id')})})
    endif

    # Navigate?
    if url != null:
        if !noSave:
            ollamaChatConversationSavePrompt()
        endif
        windowSetLocation(url)
    else:
        ollamaChatConversationSavePrompt()
        ollamaChatConversationPage(args)
    endif
endfunction


# Title update click handler
async function ollamaChatConversationOnTitleUpdate(args):
    # Update the conversation title
    title = stringTrim(documentInputValue(ollamaChatConversationTitleID))
    if title:
        systemFetch({ \
            'url': 'setConversationTitle', \
            'body': jsonStringify({'id': objectGet(args, 'id'), 'title': title}) \
        })
    endif

    # Navigate to the conversation
    ollamaChatConversationSavePrompt()
    windowSetLocation(argsURL(ollamaChatArguments))
endfunction


# Conversation template on-click event handler
async function ollamaChatConversationOnTemplate(conversation):
    # Get the template prompts
    prompts = []
    for exchange in objectGet(conversation, 'exchanges'):
        arrayPush(prompts, objectGet(exchange, 'user'))
    endfor

    # Create a template from the conversation
    templateRequest = {'title': objectGet(conversation, 'title'), 'prompts': prompts}
    templateResponse = systemFetch({'url': 'createTemplate', 'body': jsonStringify(templateRequest)})
    templateResponse = if(templateResponse != null, jsonParse(templateResponse))
    templateID = if(templateResponse != null, objectGet(templateResponse, 'id'))

    # Navigate to the template editor
    if templateID != null:
        windowSetLocation(argsURL(ollamaChatArguments, {'id': templateID, 'view': 'template'}))
    endif
endfunction


# Read Aloud on-click event handler
async function ollamaChatConversationOnReadAloud(args, ixExchange, model, final):
    key = {'id': objectGet(args, 'id'), 'exchange': ixExchange}
    voiceSpeak(key, ollamaChatVoiceText(model), final, ollamaChatVoiceGet(), ollamaChatVoiceRateGet())
    ollamaChatConversationSavePrompt()
    ollamaChatConversationPage(args)
endfunction


# Voice playback bar on-click event handler
async function ollamaChatConversationOnVoice(args, action, value):
    if action == 'play':
        voicePlay()
    elif action == 'pause':
        voicePause()
    elif action == 'rewind':
        voiceRewind()
    elif action == 'back':
        voiceParagraphBack()
    elif action == 'forward':
        voiceParagraphForward()
    elif action == 'voice':
        voiceSetVoice(value)
        localStorageSet(ollamaChatVoiceStorageKey, value)
    elif action == 'rate':
        voiceSetRate(value)
        localStorageSet(ollamaChatVoiceRateStorageKey, stringNew(value))
    else:
        voiceClose()
    endif
    ollamaChatConversationSavePrompt()
    ollamaChatConversationPage(args)
endfunction


# Helper to sync the voice playback, if any, with the conversation - update the text of the
# exchange being read aloud, or close the playback if the exchange isn't in the conversation
function ollamaChatConversationVoiceSync(args, conversation, generating):
    voice = voiceState()
    if voice == null:
        return
    endif
    key = objectGet(voice, 'key')
    ixExchange = objectGet(key, 'exchange')
    exchanges = if(conversation != null, objectGet(conversation, 'exchanges'), [])
    if objectGet(key, 'id') != objectGet(args, 'id') || ixExchange >= arrayLength(exchanges):
        voiceClose()
        return
    endif
    final = !generating || ixExchange != arrayLength(exchanges) - 1
    voiceSetText(ollamaChatVoiceText(objectGet(arrayGet(exchanges, ixExchange), 'model')), final)
endfunction


# Prompt on-enter/on-click event handler
async function ollamaChatConversationOnPrompt(args):
    id = objectGet(args, 'id')

    # Get the prompt text
    prompt = stringTrim(documentInputValue(ollamaChatConversationPromptID))
    if prompt == '':
        return
    endif

    # Starting a chat?
    if id == null:
        # Start the chat
        startRequest = jsonStringify({'user': prompt})
        startResponse = systemFetch({'url': 'startConversation', 'body': startRequest})
        startResponse = if(startResponse != null, jsonParse(startResponse))
        if startResponse == null:
            return
        endif
        id = objectGet(startResponse, 'id')

        # Navigate to the conversation ID
        windowSetLocation(argsURL(ollamaChatArguments, {'id': id}, false, ollamaChatConversationBottomID))
        return
    endif

    # Reply to that chat
    replyRequest = jsonStringify({'id': id, 'user': prompt})
    systemFetch({'url': 'replyConversation', 'body': replyRequest})

    # Render the conversation page
    ollamaChatConversationPage(args)

    # Scroll to the bottom
    windowSetLocation(argsURL(ollamaChatArguments, null, false, ollamaChatConversationBottomID))
endfunction


# The conversation page floating controls element model
function ollamaChatConversationFloatingElements(args, conversation, generating):
    action = objectGet(args, 'action')
    menuShow = objectGet(args, 'menu')
    multiline = objectGet(args, 'multiline')
    textView = objectGet(args, 'text')
    elements = []

    # Compute spacing
    fontSizePx = documentFontSize()
    topSpacePx = 2 * fontSizePx
    borderRadiusPx = 0.5 * fontSizePx
    menuPadPx = 0.65 * fontSizePx
    inputPadPx = 0.75 * fontSizePx
    textPadPx = 0.5 * fontSizePx
    buttonSize = 2 * fontSizePx
    topBottomPx = fontSizePx
    leftRightPx = 2 * fontSizePx

    # Compute button navigation URLs
    indexURL = argsURL(ollamaChatArguments, null, true)
    menuURL = argsURL(ollamaChatArguments, {'menu': !menuShow})
    titleURL = argsURL(ollamaChatArguments, if(action != 'title', {'action': 'title'}))
    markdownURL = argsURL(ollamaChatArguments, {'text': !textView})
    multilineURL = argsURL(ollamaChatArguments, {'multiline': !multiline})

    # Compute button on-click functions
    menuClickFn = systemPartial(ollamaChatConversationOnClick, args, null, menuURL, false)
    titleClickFn = systemPartial(ollamaChatConversationOnClick, args, null, titleURL, false)
    markdownClickFn = systemPartial(ollamaChatConversationOnClick, args, null, markdownURL, false)
    deleteClickFn = systemPartial(ollamaChatConversationOnClick, args, 'deleteConversation', indexURL, true)
    templateClickFn = systemPartial(ollamaChatConversationOnTemplate, conversation)
    multilineFn = systemPartial(ollamaChatConversationOnClick, args, null, multilineURL, false)

    # Generate the download URL, if necessary
    markdownDownloadURL = null
    markdownFilename = null
    if conversation != null && !generating && menuShow:
        markdownTitle = objectGet(conversation, 'title')
        markdownParts = ['# ' + markdownEscape(markdownTitle), '', '**Model:** ' + markdownEscape(objectGet(conversation, 'model'))]
        for exchange in objectGet(conversation, 'exchanges'):
            arrayPush(markdownParts, '', '## User:', '', objectGet(exchange, 'user'), '', '## Model:', '', objectGet(exchange, 'model'))
        endfor
        markdownText = arrayJoin(markdownParts, '\n')
        markdownDownloadURL = windowURLObject(markdownText, 'text/markdown')
        markdownFilename = regexReplace(regexNew('[\'"]'), stringLower(markdownTitle), '')
        markdownFilename = regexReplace(regexNew('[^a-z0-9]+'), markdownFilename, '-')
        markdownFilename = regexReplace(regexNew('^-'), markdownFilename, '')
        markdownFilename = regexReplace(regexNew('-$'), markdownFilename, '') + '.md'
    endif

    # Get the voice playback, if any
    voice = voiceState()

    # Get the saved session prompt, if any
    prompt = sessionStorageGet(ollamaChatConversationSessionKey)
    if prompt != null:
        sessionStorageRemove(ollamaChatConversationSessionKey)
    endif

    # The top space
    arrayPush(elements, { \
        'html': 'div', \
        'attr': {'style': 'height: ' + numberToFixed(topSpacePx, ollamaChatConversationSVGPrecision) + 'px'}} \
    )

    # The menu controls
    separator = '\u00a0|\u00a0'
    arrayPush(elements, { \
        'html': 'div', \
        'attr': { \
            'style': arrayJoin([ \
                'align-items: left', \
                'background-color: var(--barescript-color-background-code)', \
                'border-radius: ' + numberToFixed(borderRadiusPx, ollamaChatConversationSVGPrecision) + 'px', \
                'color: var(--barescript-color-foreground)', \
                'display: flex', \
                'left: ' + numberToFixed(topBottomPx, ollamaChatConversationSVGPrecision) + 'px', \
                'padding: ' + numberToFixed(menuPadPx, ollamaChatConversationSVGPrecision) + 'px', \
                'position: fixed', \
                'top: ' + numberToFixed(topBottomPx, ollamaChatConversationSVGPrecision) + 'px' \
            ], '; ') \
        }, \
        'elem': [ \
            formsLinkElements('Back', indexURL), \
            {'text': separator}, \
            formsLinkElements('Top', argsURL(ollamaChatArguments, null, false, '_top')), \
            {'text': separator}, \
            formsLinkElements('Bottom', argsURL(ollamaChatArguments, null, false, ollamaChatConversationBottomID)), \
            if(conversation != null && !generating, [ \
                {'text': separator}, \
                formsLinkButtonElements(if(menuShow, '<<', '>>'), menuClickFn), \
                if(menuShow, [ \
                    {'text': separator}, \
                    formsLinkButtonElements('Title', titleClickFn), \
                    {'text': separator}, \
                    formsLinkButtonElements(if(!textView, 'Text', 'Markdown'), markdownClickFn), \
                    {'text': separator}, \
                    { \
                        'html': 'a', \
                        'attr': {'href': markdownDownloadURL, 'download': markdownFilename}, \
                        'elem': {'text': 'Download'} \
                    }, \
                    {'text': separator}, \
                    formsLinkButtonElements('Template', templateClickFn), \
                    {'text': separator}, \
                    formsLinkButtonElements('Delete', deleteClickFn) \
                ]) \
            ]) \
        ] \
    })

    # The prompt controls
    arrayPush(elements, { \
        'html': 'div', \
        'attr': { \
            'style': arrayJoin([ \
                'align-items: ' + if(multiline, 'flex-end', 'center'), \
                'background-color: var(--barescript-color-border)', \
                'border-radius: ' + numberToFixed(borderRadiusPx, ollamaChatConversationSVGPrecision) + 'px', \
                'bottom: ' + numberToFixed(topBottomPx, ollamaChatConversationSVGPrecision) + 'px', \
                'display: flex', \
                'left: ' + numberToFixed(leftRightPx, ollamaChatConversationSVGPrecision) + 'px', \
                'padding: ' + numberToFixed(inputPadPx, ollamaChatConversationSVGPrecision) + 'px', \
                'position: fixed', \
                'right: ' + numberToFixed(leftRightPx, ollamaChatConversationSVGPrecision) + 'px' \
            ], '; ') \
        }, \
        'elem': [ \
            ollamaChatConversationSVGButton(0.75 * buttonSize, buttonSize, 24, 'M4,6 H20 M4,12 H20 M4,18 H20', false, false, multilineFn), \
            { \
                'html': if(multiline, 'textarea', 'input'), \
                'attr': { \
                    'autocomplete': 'off', \
                    'id': ollamaChatConversationPromptID, \
                    'placeholder': 'Type your message...', \
                    'rows': if(multiline, 8), \
                    'style': arrayJoin([ \
                        'background-color: var(--barescript-color-background)', \
                        'color: var(--barescript-color-foreground)', \
                        'border: none', \
                        'flex: 1', \
                        'font-size: inherit', \
                        'font-family: inherit', \
                        'margin-left: ' + numberToFixed(textPadPx, ollamaChatConversationSVGPrecision) + 'px', \
                        'margin-right: ' + numberToFixed(textPadPx, ollamaChatConversationSVGPrecision) + 'px', \
                        'min-width: 0', \
                        'outline: none', \
                        'padding: ' + numberToFixed(textPadPx, ollamaChatConversationSVGPrecision) + 'px', \
                        'resize: none' \
                    ], '; '), \
                    'type': if(!multiline, 'text'), \
                    'value': if(!multiline, prompt) \
                }, \
                'elem': if(multiline && prompt != null, {'text': prompt}), \
                'callback': if(!multiline && !generating, \
                    {'keyup': systemPartial(formsTextOnKeyup, systemPartial(ollamaChatConversationOnPrompt, args))} \
                ) \
            }, \
            if(!generating, \
                ollamaChatConversationSVGButton(buttonSize, buttonSize, 24, 'M12,18 V7 M7,12 L12,7 L17,12', false, true, \
                    systemPartial(ollamaChatConversationOnPrompt, args)) \
            ), \
            if(generating, \
                ollamaChatConversationSVGButton(buttonSize, buttonSize, 24, 'M8,8 H16 V16 H8 Z', true, true, \
                    systemPartial(ollamaChatConversationOnClick, args, 'stopConversation', null, false)) \
            ), \
            if(voice != null, ollamaChatConversationVoiceElements(args, voice)) \
        ] \
    })

    return elements
endfunction


# The voice playback bar element model - floats above the prompt controls, centered
function ollamaChatConversationVoiceElements(args, voice):
    playing = objectGet(voice, 'playing')
    voiceKey = objectGet(voice, 'voice')
    rate = objectGet(voice, 'rate')

    # Compute spacing
    fontSizePx = documentFontSize()
    borderRadiusPx = 0.5 * fontSizePx
    barPadPx = 0.5 * fontSizePx
    barSpacePx = 0.5 * fontSizePx
    buttonSize = 2 * fontSizePx
    smallButtonSize = 0.75 * buttonSize

    # Compute button on-click functions
    rewindClickFn = systemPartial(ollamaChatConversationOnVoice, args, 'rewind', null)
    backClickFn = systemPartial(ollamaChatConversationOnVoice, args, 'back', null)
    playClickFn = systemPartial(ollamaChatConversationOnVoice, args, if(playing, 'pause', 'play'), null)
    forwardClickFn = systemPartial(ollamaChatConversationOnVoice, args, 'forward', null)
    voiceClickFn = systemPartial(ollamaChatConversationOnVoice, args, 'voice', ollamaChatVoiceNext(voiceKey))
    rateClickFn = systemPartial(ollamaChatConversationOnVoice, args, 'rate', ollamaChatVoiceRateNext(rate))
    closeClickFn = systemPartial(ollamaChatConversationOnVoice, args, 'close', null)

    return { \
        'html': 'div', \
        'attr': { \
            'style': arrayJoin([ \
                'align-items: center', \
                'background-color: var(--barescript-color-border)', \
                'border-radius: ' + numberToFixed(borderRadiusPx, ollamaChatConversationSVGPrecision) + 'px', \
                'bottom: calc(100% + ' + numberToFixed(barSpacePx, ollamaChatConversationSVGPrecision) + 'px)', \
                'display: flex', \
                'left: 50%', \
                'padding: ' + numberToFixed(barPadPx, ollamaChatConversationSVGPrecision) + 'px', \
                'position: absolute', \
                'transform: translateX(-50%)', \
                'white-space: nowrap' \
            ], '; ') \
        }, \
        'elem': [ \
            ollamaChatConversationSVGButton(smallButtonSize, smallButtonSize, 24, 'M5,6 H8 V18 H5 Z M19,6 L10,12 L19,18 Z', \
                true, false, rewindClickFn), \
            {'text': '\u00a0'}, \
            ollamaChatConversationSVGButton(smallButtonSize, smallButtonSize, 24, 'M12,6 L3,12 L12,18 Z M21,6 L12,12 L21,18 Z', \
                true, false, backClickFn), \
            {'text': '\u00a0'}, \
            ollamaChatConversationSVGButton(buttonSize, buttonSize, 24, \
                if(playing, 'M8,6 H11 V18 H8 Z M13,6 H16 V18 H13 Z', 'M9,6 L18,12 L9,18 Z'), true, true, playClickFn), \
            {'text': '\u00a0'}, \
            ollamaChatConversationSVGButton(smallButtonSize, smallButtonSize, 24, 'M3,6 L12,12 L3,18 Z M12,6 L21,12 L12,18 Z', \
                true, false, forwardClickFn), \
            {'text': '\u00a0\u00a0'}, \
            formsLinkButtonElements(ollamaChatVoiceLabel(voiceKey), voiceClickFn), \
            {'text': '\u00a0|\u00a0'}, \
            formsLinkButtonElements(rate + 'x', rateClickFn), \
            {'text': '\u00a0\u00a0'}, \
            ollamaChatConversationSVGButton(smallButtonSize, smallButtonSize, 24, 'M7,7 L17,17 M17,7 L7,17', false, false, \
                closeClickFn) \
        ] \
    }
endfunction


# Create an SVG button element model
function ollamaChatConversationSVGButton(width, height, viewSize, symbolPath, symbolFill, backgroundFill, callback):
    symbolFillColor = if(symbolFill, 'var(--barescript-color-foreground)', 'none')
    symbolStrokeColor = if(symbolFill, 'none', 'var(--barescript-color-foreground)')
    return { \
        'html': 'button', \
        'attr': { \
            'type': 'button', \
            'style': arrayJoin([ \
                'background: transparent', \
                'border: none', \
                'padding: 0', \
                'cursor: pointer' \
            ], '; '), \
            'onmouseover': "this.children[0].style.opacity='" + if(backgroundFill, '0.8', '0.6') + "';", \
            'onmouseout': "this.children[0].style.opacity='1';" \
        }, \
        'elem': { \
            'svg': 'svg', \
            'attr': { \
                'width': numberToFixed(width, ollamaChatConversationSVGPrecision), \
                'height': numberToFixed(height, ollamaChatConversationSVGPrecision), \
                'viewBox': '0 0 ' + viewSize + ' ' + viewSize, \
                'fill': 'none', \
                'style': 'vertical-align: middle', \
                'preserveAspectRatio': 'none' \
            }, \
            'elem': [ \
                if(backgroundFill, { \
                    'svg': 'circle', \
                    'attr': { \
                        'cx': numberToFixed(0.5 * viewSize, ollamaChatConversationSVGPrecision), \
                        'cy': numberToFixed(0.5 * viewSize, ollamaChatConversationSVGPrecision), \
                        'r': numberToFixed(0.5 * viewSize, ollamaChatConversationSVGPrecision), \
                        'style': 'fill: var(--barescript-color-background); stroke: none' \
                    } \
                }), \
                { \
                    'svg': 'path', \
                    'attr': { \
                        'd': symbolPath, \
                        'style': 'fill: ' + symbolFillColor + \
                            '; stroke: ' + symbolStrokeColor + \
                            '; stroke-width: ' + numberToFixed(0.1 * viewSize) \
                    } \
                } \
            ] \
        }, \
        'callback': {'click': callback} \
    }
endfunction
